@model Colis
@{
    ViewData["Title"] = "Modifier le Colis #" + Model.Id;
}

<div class="breadcrumb">
  <a href="/Home/Index"><i class="fa-solid fa-house"></i></a>
  <span>/</span>
  <a href="/Colis/Index">Colis</a>
  <span>/</span>
  Modifier #@Model.Id
</div>

<div style="max-width:700px">
  <h1 style="margin-bottom:6px">Modifier le Colis <span style="color:var(--primary)">#@Model.Id</span></h1>
  <p style="color:var(--text-muted);font-size:0.875rem;margin-bottom:24px">Mettez à jour les informations du colis.</p>

  <div class="card">
    <div class="card-body">
      <form asp-action="Edit" asp-controller="Colis" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="DateCreation" />

        @if (!ViewData.ModelState.IsValid)
        {
          <div style="background:var(--danger-light);border:1px solid var(--danger);border-radius:var(--radius);padding:12px 16px;margin-bottom:16px;font-size:0.85rem;color:var(--danger)">
            <i class="fa-solid fa-triangle-exclamation" style="margin-right:6px"></i>
            <strong>Erreur :</strong> Veuillez corriger les champs ci-dessous.
            <div asp-validation-summary="ModelOnly" style="margin-top:6px"></div>
          </div>
        }

        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Client <span style="color:var(--danger)">*</span></label>
            <select asp-for="ClientId" asp-items="ViewBag.Clients" class="form-control">
              <option value="">— Sélectionner un client —</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Livreur</label>
            <select asp-for="LivreurId" asp-items="ViewBag.Livreurs" class="form-control">
              <option value="">— Non assigné —</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Description</label>
          <input asp-for="Description" class="form-control" />
        </div>

        <div class="form-grid-3">
          <div class="form-group">
            <label class="form-label">Montant (DT)</label>
            <input asp-for="Montant" class="form-control" type="number" step="0.01" />
          </div>
          <div class="form-group">
            <label class="form-label">Poids (kg)</label>
            <input asp-for="Poids" class="form-control" type="number" step="0.001" />
          </div>
          <div class="form-group">
            <label class="form-label">Volume (m³)</label>
            <input asp-for="Volume" class="form-control" type="number" step="0.001" />
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Date de Livraison</label>
            <input asp-for="DateLivraison" class="form-control" type="datetime-local" />
          </div>
          <div class="form-group">
            <label class="form-label">Statut</label>
            <select asp-for="Statut" class="form-control"
                    asp-items="Html.GetEnumSelectList<StatutColis>()"></select>
          </div>
        </div>

        <div style="display:flex;gap:12px;margin-top:8px">
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk"></i> Enregistrer
          </button>
          <a href="/Colis/Details/@Model.Id" class="btn btn-secondary">
            <i class="fa-solid fa-eye"></i> Voir détails
          </a>
          <a href="/Colis/Index" class="btn btn-secondary">Annuler</a>
        </div>
      </form>
    </div>
  </div>
</div>
