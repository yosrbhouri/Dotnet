@model DashboardViewModel
@using DeliveryApp.Models
@{
    ViewData["Title"] = "Tableau de bord";
}

@if (Model.IsAdmin)
{
<!-- ══════════════════════════════════════════════════════════════════════
     ADMIN DASHBOARD
     ══════════════════════════════════════════════════════════════════════ -->
<div class="anim-fade-up" style="background:linear-gradient(135deg,var(--primary),#6366f1,var(--accent));border-radius:var(--radius-xl);padding:32px 36px;margin-bottom:26px;color:white;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-40px;right:-40px;width:200px;height:200px;background:rgba(255,255,255,0.08);border-radius:50%;"></div>
  <div style="position:relative;z-index:1;">
    <h1 style="color:white;margin-bottom:6px;font-size:1.6rem;">Administration</h1>
    <p style="color:rgba(255,255,255,0.8);font-size:0.92rem;margin:0;">Vue globale de toute l'activite.</p>
  </div>
</div>

<div class="stat-grid">
  <div class="stat-card" style="--accent-color:var(--primary);--icon-bg:var(--primary-light)">
    <div class="stat-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
    <div><div class="stat-value">@Model.TotalColis</div><div class="stat-label">Total Colis</div></div>
  </div>
  <div class="stat-card" style="--accent-color:var(--warning);--icon-bg:var(--warning-light)">
    <div class="stat-icon"><i class="fa-solid fa-clock"></i></div>
    <div><div class="stat-value">@Model.ColisEnAttente</div><div class="stat-label">En Attente</div></div>
  </div>
  <div class="stat-card" style="--accent-color:var(--info);--icon-bg:var(--info-light)">
    <div class="stat-icon"><i class="fa-solid fa-truck-fast"></i></div>
    <div><div class="stat-value">@Model.ColisEnCours</div><div class="stat-label">En Cours</div></div>
  </div>
  <div class="stat-card" style="--accent-color:var(--success);--icon-bg:var(--success-light)">
    <div class="stat-icon"><i class="fa-solid fa-circle-check"></i></div>
    <div><div class="stat-value">@Model.ColisLivres</div><div class="stat-label">Livres</div></div>
  </div>
  <div class="stat-card" style="--accent-color:#8b5cf6;--icon-bg:#ede9fe">
    <div class="stat-icon"><i class="fa-solid fa-coins"></i></div>
    <div><div class="stat-value">@Model.MontantTotal.ToString("N0") <span style="font-size:0.8rem;font-weight:600;color:var(--text-soft)">DT</span></div><div class="stat-label">Chiffre d'affaires</div></div>
  </div>
  <div class="stat-card" style="--accent-color:var(--accent);--icon-bg:var(--accent-light)">
    <div class="stat-icon"><i class="fa-solid fa-users"></i></div>
    <div><div class="stat-value">@Model.TotalClients</div><div class="stat-label">Clients</div></div>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1.8fr;gap:20px;margin-bottom:24px">
  <div class="card anim-fade-up anim-delay-1">
    <div class="card-header"><span class="card-title"><i class="fa-solid fa-chart-pie"></i> Repartition</span></div>
    <div class="card-body" style="display:flex;flex-direction:column;align-items:center">
      <div class="chart-container" style="width:220px;height:220px"><canvas id="donutChart"></canvas></div>
      <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:18px;justify-content:center">
        <span style="display:flex;align-items:center;gap:6px;font-size:0.78rem;color:var(--text-muted)"><span style="width:10px;height:10px;border-radius:4px;background:#f59e0b"></span>En attente (@Model.ColisEnAttente)</span>
        <span style="display:flex;align-items:center;gap:6px;font-size:0.78rem;color:var(--text-muted)"><span style="width:10px;height:10px;border-radius:4px;background:#3b82f6"></span>En cours (@Model.ColisEnCours)</span>
        <span style="display:flex;align-items:center;gap:6px;font-size:0.78rem;color:var(--text-muted)"><span style="width:10px;height:10px;border-radius:4px;background:#10b981"></span>Livres (@Model.ColisLivres)</span>
        <span style="display:flex;align-items:center;gap:6px;font-size:0.78rem;color:var(--text-muted)"><span style="width:10px;height:10px;border-radius:4px;background:#ef4444"></span>Annules (@Model.ColisAnnules)</span>
      </div>
    </div>
  </div>
  <div class="card anim-fade-up anim-delay-2">
    <div class="card-header">
      <span class="card-title"><i class="fa-solid fa-box"></i> Colis Recents</span>
      <a href="/Colis/Index" class="btn btn-secondary btn-sm"><i class="fa-solid fa-arrow-right"></i> Voir tout</a>
    </div>
    <div class="table-wrap" style="border:none;box-shadow:none;border-radius:0">
      <table>
        <thead><tr><th>#</th><th>Client</th><th>Montant</th><th>Statut</th><th>Date</th></tr></thead>
        <tbody>
          @foreach (var c in Model.RecentColis)
          {
            <tr>
              <td><span style="color:var(--text-soft);font-family:monospace;font-size:0.82rem">#@c.Id</span></td>
              <td><strong style="font-size:0.85rem">@(c.Client?.Nom ?? "-") @(c.Client?.Prenom ?? "")</strong></td>
              <td><span style="color:var(--primary);font-weight:700">@c.Montant.ToString("N2") DT</span></td>
              <td>
                @{ var (cls, lbl) = c.Statut switch { StatutColis.EnAttente => ("badge-warning","En attente"), StatutColis.EnCours => ("badge-info","En cours"), StatutColis.Livré => ("badge-success","Livre"), _ => ("badge-danger","Annule") }; }
                <span class="badge @cls">@lbl</span>
              </td>
              <td style="color:var(--text-soft);font-size:0.82rem">@c.DateCreation.ToString("dd/MM/yyyy")</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card anim-fade-up anim-delay-3">
  <div class="card-header"><span class="card-title"><i class="fa-solid fa-bolt"></i> Actions Rapides</span></div>
  <div class="card-body" style="display:flex;flex-wrap:wrap;gap:14px">
    <a href="/Admin/Clients" class="btn btn-secondary"><i class="fa-solid fa-users"></i> Gerer Clients</a>
    <a href="/Admin/Livreurs" class="btn btn-secondary"><i class="fa-solid fa-person-biking"></i> Gerer Livreurs</a>
    <a href="/Admin/Vehicules" class="btn btn-secondary"><i class="fa-solid fa-truck"></i> Gerer Vehicules</a>
    <a href="/Admin/Users" class="btn btn-secondary"><i class="fa-solid fa-user-shield"></i> Utilisateurs</a>
  </div>
</div>
}
else
{
<!-- ══════════════════════════════════════════════════════════════════════
     USER DASHBOARD - Design completement different
     ══════════════════════════════════════════════════════════════════════ -->
<style>
  .user-hero { background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%); border-radius: 20px; padding: 36px 40px; margin-bottom: 28px; color: white; position: relative; overflow: hidden; }
  .user-hero::before { content:''; position:absolute; top:-80px; right:-80px; width:250px; height:250px; background:rgba(99,102,241,0.15); border-radius:50%; }
  .user-hero::after { content:''; position:absolute; bottom:-60px; left:40%; width:200px; height:200px; background:rgba(16,185,129,0.1); border-radius:50%; }
  .user-hero h1 { font-size:1.5rem; font-weight:800; margin-bottom:4px; position:relative; z-index:1; }
  .user-hero p { color:rgba(255,255,255,0.6); font-size:0.88rem; margin:0; position:relative; z-index:1; }

  .user-stats { display:grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap:16px; margin-bottom:28px; }
  .user-stat-card { background:white; border-radius:16px; padding:22px 20px; text-align:center; border:1px solid #f1f5f9; box-shadow:0 2px 12px rgba(0,0,0,0.04); transition:all .2s; }
  .user-stat-card:hover { transform:translateY(-3px); box-shadow:0 8px 24px rgba(0,0,0,0.08); }
  .user-stat-card .num { font-size:1.8rem; font-weight:800; line-height:1; margin-bottom:4px; }
  .user-stat-card .label { font-size:0.75rem; text-transform:uppercase; letter-spacing:1px; color:#64748b; font-weight:600; }

  .user-colis-list { background:white; border-radius:16px; border:1px solid #f1f5f9; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,0.04); }
  .user-colis-header { padding:20px 24px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between; }
  .user-colis-header h2 { font-size:1.05rem; font-weight:700; margin:0; color:#1e293b; }
  .user-colis-item { display:grid; grid-template-columns: 50px 1.5fr 1fr 1fr 100px; align-items:center; padding:16px 24px; border-bottom:1px solid #f8fafc; transition:background .15s; }
  .user-colis-item:hover { background:#f8fafc; }
  .user-colis-item:last-child { border-bottom:none; }
  .user-colis-id { font-family:monospace; font-size:0.82rem; color:#94a3b8; font-weight:600; }
  .user-colis-desc { font-weight:600; color:#1e293b; font-size:0.88rem; }
  .user-colis-amount { font-weight:700; color:#6366f1; font-size:0.92rem; }
  .user-colis-date { font-size:0.8rem; color:#94a3b8; }

  .user-badge { padding:4px 10px; border-radius:20px; font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; }
  .user-badge-waiting { background:#fef3c7; color:#92400e; }
  .user-badge-progress { background:#dbeafe; color:#1e40af; }
  .user-badge-done { background:#d1fae5; color:#065f46; }
  .user-badge-cancelled { background:#fee2e2; color:#991b1b; }

  .user-empty { text-align:center; padding:60px 20px; }
  .user-empty-icon { font-size:3rem; margin-bottom:12px; }
  .user-empty p { color:#94a3b8; font-size:0.92rem; }

  .user-action-btn { display:inline-flex; align-items:center; gap:8px; padding:10px 20px; border-radius:12px; font-weight:600; font-size:0.88rem; text-decoration:none; transition:all .2s; }
  .user-action-btn:hover { transform:translateY(-2px); }
  .btn-user-primary { background:#6366f1; color:white; }
  .btn-user-primary:hover { background:#4f46e5; color:white; }
  .btn-user-secondary { background:#f1f5f9; color:#475569; }
  .btn-user-secondary:hover { background:#e2e8f0; color:#1e293b; }
</style>

<div class="user-hero">
  <h1>@(Model.TypeUtilisateur == UserType.Client ? "📦" : "🚚") Bonjour, @(Model.FullName ?? User.Identity?.Name?.Split("@@")[0] ?? "Utilisateur")</h1>
  <p>
    @if (Model.TypeUtilisateur == UserType.Client)
    {
      @:Gerez vos envois et suivez vos colis en temps reel.
    }
    else
    {
      @:Consultez vos livraisons et suivez votre activite.
    }
  </p>
</div>

<div class="user-stats">
  <div class="user-stat-card">
    <div class="num" style="color:#6366f1">@Model.TotalColis</div>
    <div class="label">@(Model.TypeUtilisateur == UserType.Client ? "Mes Colis" : "Mes Livraisons")</div>
  </div>
  <div class="user-stat-card">
    <div class="num" style="color:#f59e0b">@Model.ColisEnAttente</div>
    <div class="label">En attente</div>
  </div>
  <div class="user-stat-card">
    <div class="num" style="color:#3b82f6">@Model.ColisEnCours</div>
    <div class="label">En cours</div>
  </div>
  <div class="user-stat-card">
    <div class="num" style="color:#10b981">@Model.ColisLivres</div>
    <div class="label">@(Model.TypeUtilisateur == UserType.Client ? "Livres" : "Livres")</div>
  </div>
</div>

<div style="display:flex;gap:12px;margin-bottom:24px">
  @if (Model.TypeUtilisateur == UserType.Client)
  {
    <a href="/Colis/Create" class="user-action-btn btn-user-primary"><i class="fa-solid fa-plus"></i> Nouveau Colis</a>
  }
  <a href="/Colis/Index" class="user-action-btn btn-user-secondary"><i class="fa-solid fa-list"></i> Voir tout</a>
  <a href="/Notification/Index" class="user-action-btn btn-user-secondary"><i class="fa-solid fa-bell"></i> Notifications</a>
</div>

<div class="user-colis-list">
  <div class="user-colis-header">
    <h2><i class="fa-solid fa-box" style="color:#6366f1;margin-right:8px"></i>@(Model.TypeUtilisateur == UserType.Client ? "Mes Colis Recents" : "Mes Livraisons Recentes")</h2>
    <span style="font-size:0.82rem;color:#94a3b8">@Model.TotalColis au total</span>
  </div>

  @if (Model.RecentColis.Any())
  {
    <div style="padding:0">
      @foreach (var c in Model.RecentColis)
      {
        var badgeClass = c.Statut switch {
          StatutColis.EnAttente => "user-badge-waiting",
          StatutColis.EnCours => "user-badge-progress",
          StatutColis.Livré => "user-badge-done",
          _ => "user-badge-cancelled"
        };
        var badgeText = c.Statut switch {
          StatutColis.EnAttente => "En attente",
          StatutColis.EnCours => "En cours",
          StatutColis.Livré => "Livre",
          _ => "Annule"
        };
        <div class="user-colis-item">
          <span class="user-colis-id">#@c.Id</span>
          <span class="user-colis-desc">@(c.Description ?? "Colis #" + c.Id)</span>
          <span class="user-colis-amount">@c.Montant.ToString("N2") DT</span>
          <span class="user-badge @badgeClass">@badgeText</span>
          <span class="user-colis-date">@c.DateCreation.ToString("dd/MM/yy")</span>
        </div>
      }
    </div>
  }
  else
  {
    <div class="user-empty">
      <div class="user-empty-icon">@(Model.TypeUtilisateur == UserType.Client ? "📦" : "🚚")</div>
      <p>
        @if (Model.TypeUtilisateur == UserType.Client)
        {
          @:Vous n'avez pas encore envoye de colis.
        }
        else
        {
          @:Aucune livraison assignee pour le moment.
        }
      </p>
      @if (Model.TypeUtilisateur == UserType.Client)
      {
        <a href="/Colis/Create" class="user-action-btn btn-user-primary" style="margin-top:12px"><i class="fa-solid fa-plus"></i> Envoyer un colis</a>
      }
    </div>
  }
</div>
}

@section Scripts {
@if (Model.IsAdmin)
{
<script>
const ctx = document.getElementById('donutChart');
new Chart(ctx, {
  type: 'doughnut',
  data: {
    labels: ['En attente','En cours','Livres','Annules'],
    datasets: [{
      data: [@Model.ColisEnAttente, @Model.ColisEnCours, @Model.ColisLivres, @Model.ColisAnnules],
      backgroundColor: ['#f59e0b','#3b82f6','#10b981','#ef4444'],
      borderColor: '#ffffff',
      borderWidth: 3,
      hoverOffset: 10
    }]
  },
  options: {
    cutout: '72%',
    plugins: { legend: { display: false }, tooltip: { backgroundColor:'#0f172a', cornerRadius:10, padding:12 } },
    responsive: true,
    maintainAspectRatio: false,
    animation: { animateRotate: true, duration: 1000, easing: 'easeOutQuart' }
  }
});
</script>
}
}
