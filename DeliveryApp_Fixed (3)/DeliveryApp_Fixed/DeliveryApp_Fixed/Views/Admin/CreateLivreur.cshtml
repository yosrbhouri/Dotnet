@model DeliveryApp.Models.Livreur
@{
    ViewData["Title"] = "Nouveau Livreur";
}

<div class="breadcrumb">
  <a href="/Admin/Livreurs">Livreurs</a><span>/</span> Créer
</div>

<div style="max-width:600px">
  <h1 style="margin-bottom:22px">Nouveau Livreur</h1>
  <div class="card">
    <div class="card-body">
      <form asp-action="CreateLivreur" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
          <label class="form-label">Raison Sociale <span style="color:var(--danger)">*</span></label>
          <input asp-for="RaisonSociale" class="form-control" placeholder="Express Livraison SARL" />
          <span asp-validation-for="RaisonSociale" style="color:var(--danger);font-size:0.78rem"></span>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">CIN <span style="color:var(--danger)">*</span></label>
            <input asp-for="CIN" class="form-control" placeholder="12345678" />
            <span asp-validation-for="CIN" style="color:var(--danger);font-size:0.78rem"></span>
          </div>
          <div class="form-group">
            <label class="form-label">Ville <span style="color:var(--danger)">*</span></label>
            <input asp-for="Ville" class="form-control" placeholder="Tunis" />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Code Postal <span style="color:var(--danger)">*</span></label>
          <input asp-for="CodePostal" class="form-control" placeholder="1000" style="max-width:160px" />
        </div>

        <p style="color:var(--text-muted);font-size:0.82rem;margin-top:8px">
          <i class="fa-solid fa-circle-info"></i> Les véhicules sont gérés dans la section
          <a href="/Admin/Vehicules" style="color:var(--primary);font-weight:500">Véhicules</a>.
        </p>

        <div style="display:flex;gap:12px;margin-top:8px">
          <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Créer</button>
          <a href="/Admin/Livreurs" class="btn btn-secondary">Annuler</a>
        </div>
      </form>
    </div>
  </div>
</div>
