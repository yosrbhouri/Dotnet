@model IEnumerable<DeliveryApp.Models.Client>
@{
    ViewData["Title"] = "Gestion des Clients";
}

<div class="breadcrumb">
  <a href="/Admin/Index"><i class="fa-solid fa-gauge-high"></i></a>
  <span>/</span> Clients
</div>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:22px">
  <div>
    <h1>Clients</h1>
    <p style="color:var(--text-muted);font-size:0.875rem">@Model.Count() clients enregistrés</p>
  </div>
  <a href="/Admin/CreateClient" class="btn btn-primary">
    <i class="fa-solid fa-plus"></i> Nouveau Client
  </a>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Nom &amp; Prénom</th><th>Email</th><th>Téléphone</th><th>Ville</th><th>CP</th><th>Colis</th><th style="text-align:right">Actions</th></tr>
      </thead>
      <tbody>
        @foreach (var c in Model)
        {
          <tr>
            <td>
              <div style="display:flex;align-items:center;gap:10px">
                <div style="width:34px;height:34px;background:var(--primary-light);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--primary);font-weight:700;font-size:0.85rem;flex-shrink:0">
                  @c.Nom.Substring(0,1).ToUpper()
                </div>
                <div>
                  <div style="font-weight:600">@c.Nom @c.Prenom</div>
                </div>
              </div>
            </td>
            <td style="font-size:0.85rem;color:var(--text-muted)">@(c.Email ?? "—")</td>
            <td style="font-size:0.85rem">@(c.Telephone ?? "—")</td>
            <td>@c.Ville</td>
            <td style="font-family:monospace;font-size:0.82rem">@c.CodePostal</td>
            <td>
              <span style="background:var(--primary-light);color:var(--primary);padding:3px 10px;border-radius:20px;font-size:0.78rem;font-weight:600">
                @c.Colis.Count()
              </span>
            </td>
            <td>
              <div style="display:flex;justify-content:flex-end;gap:6px">
                <a href="/Admin/EditClient/@c.Id" class="btn btn-secondary btn-sm"><i class="fa-solid fa-pen"></i></a>
                <form asp-action="DeleteClient" method="post" style="display:inline" onsubmit="return confirm('Supprimer ce client ?')">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@c.Id" />
                  <button type="submit" class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i></button>
                </form>
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
    @if (!Model.Any())
    {
      <div class="empty-state"><div class="empty-icon">👥</div><p>Aucun client enregistré.</p></div>
    }
  </div>
</div>
