@{
    ViewData["Title"] = "Administration";
    var stats = ViewBag.Stats as DeliveryApp.Services.ColisStatistiques;
    var recent = ViewBag.RecentColis as IEnumerable<DeliveryApp.Models.Colis>;
}

<div class="breadcrumb">
  <a href="/Home/Index"><i class="fa-solid fa-house"></i></a>
  <span>/</span> Administration
</div>

<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:24px">
  <div>
    <h1>Panneau d'Administration</h1>
    <p style="color:var(--text-muted);font-size:0.875rem">Vue d'ensemble et statistiques en temps réel</p>
  </div>
  <a href="/Colis/Create" class="btn btn-primary">
    <i class="fa-solid fa-plus"></i> Nouveau Colis
  </a>
</div>

<!-- Stats -->
<div class="stat-grid" style="grid-template-columns:repeat(auto-fit,minmax(170px,1fr))">
  <div class="stat-card" style="--accent-color:var(--primary);--icon-bg:var(--primary-light)">
    <div class="stat-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
    <div><div class="stat-value">@stats?.TotalColis</div><div class="stat-label">Total Colis</div></div>
  </div>
  <div class="stat-card" style="--accent-color:var(--success);--icon-bg:rgba(45,212,160,0.15)">
    <div class="stat-icon"><i class="fa-solid fa-circle-check"></i></div>
    <div><div class="stat-value">@stats?.ColisLivres</div><div class="stat-label">Livrés</div></div>
  </div>
  <div class="stat-card" style="--accent-color:var(--info);--icon-bg:rgba(77,171,247,0.15)">
    <div class="stat-icon"><i class="fa-solid fa-truck-fast"></i></div>
    <div><div class="stat-value">@stats?.ColisEnCours</div><div class="stat-label">En Cours</div></div>
  </div>
  <div class="stat-card" style="--accent-color:var(--warning);--icon-bg:rgba(255,209,102,0.15)">
    <div class="stat-icon"><i class="fa-solid fa-clock"></i></div>
    <div><div class="stat-value">@stats?.ColisEnAttente</div><div class="stat-label">En Attente</div></div>
  </div>
  <div class="stat-card" style="--accent-color:var(--primary);--icon-bg:var(--primary-light)">
    <div class="stat-icon"><i class="fa-solid fa-coins"></i></div>
    <div><div class="stat-value">@stats?.MontantTotal.ToString("N0") DT</div><div class="stat-label">CA Total</div></div>
  </div>
  <div class="stat-card" style="--accent-color:var(--info);--icon-bg:rgba(77,171,247,0.15)">
    <div class="stat-icon"><i class="fa-solid fa-users"></i></div>
    <div><div class="stat-value">@stats?.TotalClients</div><div class="stat-label">Clients</div></div>
  </div>
  <div class="stat-card" style="--accent-color:var(--success);--icon-bg:rgba(45,212,160,0.15)">
    <div class="stat-icon"><i class="fa-solid fa-person-biking"></i></div>
    <div><div class="stat-value">@stats?.TotalLivreurs</div><div class="stat-label">Livreurs</div></div>
  </div>
  <div class="stat-card" style="--accent-color:var(--warning);--icon-bg:rgba(255,209,102,0.15)">
    <div class="stat-icon"><i class="fa-solid fa-truck"></i></div>
    <div><div class="stat-value">@stats?.TotalVehicules</div><div class="stat-label">Véhicules</div></div>
  </div>
</div>

<!-- Charts Row -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:22px">
  <div class="card">
    <div class="card-header">
      <span class="card-title"><i class="fa-solid fa-chart-pie" style="color:var(--primary);margin-right:8px"></i>Répartition des Statuts</span>
    </div>
    <div class="card-body" style="display:flex;justify-content:center">
      <div style="width:240px;height:240px"><canvas id="statusChart"></canvas></div>
    </div>
  </div>
  <div class="card">
    <div class="card-header">
      <span class="card-title"><i class="fa-solid fa-chart-bar" style="color:var(--primary);margin-right:8px"></i>Vue d'ensemble</span>
    </div>
    <div class="card-body">
      <div style="height:240px"><canvas id="barChart"></canvas></div>
    </div>
  </div>
</div>

<!-- Quick Links -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-bottom:24px">
  @foreach (var (icon, label, url, color) in new[]{
    ("fa-users","Gérer les Clients","/Admin/Clients","var(--info)"),
    ("fa-person-biking","Gérer les Livreurs","/Admin/Livreurs","var(--success)"),
    ("fa-truck","Gérer les Véhicules","/Admin/Vehicules","var(--warning)"),
    ("fa-user-shield","Gérer les Utilisateurs","/Admin/Users","var(--primary)"),
  })
  {
    <a href="@url" style="text-decoration:none">
      <div class="card" style="padding:20px;display:flex;align-items:center;gap:14px;border-left:3px solid @color;transition:all 0.2s">
        <div style="width:44px;height:44px;border-radius:10px;background:rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:center;color:@color;font-size:1.1rem;flex-shrink:0">
          <i class="fa-solid @icon"></i>
        </div>
        <div>
          <div style="font-weight:700;font-size:0.9rem">@label</div>
          <div style="color:var(--text-muted);font-size:0.76rem">Voir &amp; gérer</div>
        </div>
        <i class="fa-solid fa-arrow-right" style="margin-left:auto;color:var(--text-muted);font-size:0.8rem"></i>
      </div>
    </a>
  }
</div>

<!-- Recent Colis Table -->
<div class="card">
  <div class="card-header">
    <span class="card-title"><i class="fa-solid fa-list" style="color:var(--primary);margin-right:8px"></i>Derniers Colis</span>
    <a href="/Colis/Index" class="btn btn-secondary btn-sm">Voir tout</a>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>#</th><th>Description</th><th>Client</th><th>Livreur</th><th>Montant</th><th>Statut</th><th>Date</th><th>Actions</th></tr>
      </thead>
      <tbody>
        @foreach (var c in (recent ?? Enumerable.Empty<DeliveryApp.Models.Colis>()))
        {
          var (cls, lbl) = c.Statut switch {
            DeliveryApp.Models.StatutColis.EnAttente => ("badge-warning","En attente"),
            DeliveryApp.Models.StatutColis.EnCours   => ("badge-info","En cours"),
            DeliveryApp.Models.StatutColis.Livré     => ("badge-success","Livré"),
            _                                        => ("badge-danger","Annulé")
          };
          <tr>
            <td><span style="color:var(--text-muted);font-family:monospace">#@c.Id</span></td>
            <td>@(c.Description??"—")</td>
            <td>@(c.Client!=null?$"{c.Client.Nom} {c.Client.Prenom}":"—")</td>
            <td>@(c.Livreur?.RaisonSociale??"—")</td>
            <td style="color:var(--primary);font-weight:700">@c.Montant.ToString("N2") DT</td>
            <td><span class="badge @cls">@lbl</span></td>
            <td style="font-size:0.82rem">@c.DateCreation.ToString("dd/MM/yy")</td>
            <td>
              <a href="/Colis/Edit/@c.Id" class="btn btn-secondary btn-sm"><i class="fa-solid fa-pen"></i></a>
              <a href="/Colis/Details/@c.Id" class="btn btn-secondary btn-sm"><i class="fa-solid fa-eye"></i></a>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@section Scripts {
<script>
// Pie chart
new Chart(document.getElementById('statusChart'), {
  type: 'doughnut',
  data: {
    labels: ['En attente','En cours','Livrés','Annulés'],
    datasets: [{ data: [@stats?.ColisEnAttente,@stats?.ColisEnCours,@stats?.ColisLivres,@stats?.ColisAnnules],
      backgroundColor: ['#f59e0b','#3b82f6','#10b981','#ef4444'], borderColor:'#fff', borderWidth:2 }]
  },
  options: { cutout: '65%', plugins: { legend: { position: 'bottom', labels: { color:'#64748b', padding:14, font:{size:12} } } }, maintainAspectRatio: false }
});
// Bar chart
new Chart(document.getElementById('barChart'), {
  type: 'bar',
  data: {
    labels: ['Colis','Clients','Livreurs','Véhicules'],
    datasets: [{ label: 'Nombre', data: [@stats?.TotalColis,@stats?.TotalClients,@stats?.TotalLivreurs,@stats?.TotalVehicules],
      backgroundColor: ['#4f46e5','#3b82f6','#10b981','#f59e0b'], borderRadius: 10 }]
  },
  options: { plugins: { legend: { display: false } }, scales: { x: { ticks: { color:'#64748b' }, grid: { display:false } }, y: { ticks: { color:'#64748b' }, grid: { color:'#f1f5f9' } } }, maintainAspectRatio: false }
});
</script>
}
