@model DeliveryApp.Models.Client
@{
    ViewData["Title"] = "Nouveau Client";
}

<div class="breadcrumb">
  <a href="/Admin/Clients">Clients</a><span>/</span> Créer
</div>

<div style="max-width:600px">
  <h1 style="margin-bottom:22px">Nouveau Client</h1>
  <div class="card">
    <div class="card-body">
      <form asp-action="CreateClient" method="post">
        @Html.AntiForgeryToken()
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Nom <span style="color:var(--danger)">*</span></label>
            <input asp-for="Nom" class="form-control" placeholder="Ben Ali" />
            <span asp-validation-for="Nom" style="color:var(--danger);font-size:0.78rem"></span>
          </div>
          <div class="form-group">
            <label class="form-label">Prénom <span style="color:var(--danger)">*</span></label>
            <input asp-for="Prenom" class="form-control" placeholder="Mohamed" />
            <span asp-validation-for="Prenom" style="color:var(--danger);font-size:0.78rem"></span>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Email</label>
          <input asp-for="Email" class="form-control" type="email" placeholder="email@exemple.tn" />
          <span asp-validation-for="Email" style="color:var(--danger);font-size:0.78rem"></span>
        </div>
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Téléphone</label>
            <input asp-for="Telephone" class="form-control" placeholder="20123456" />
          </div>
          <div class="form-group">
            <label class="form-label">Ville <span style="color:var(--danger)">*</span></label>
            <input asp-for="Ville" class="form-control" placeholder="Tunis" />
            <span asp-validation-for="Ville" style="color:var(--danger);font-size:0.78rem"></span>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Code Postal <span style="color:var(--danger)">*</span></label>
          <input asp-for="CodePostal" class="form-control" placeholder="1000" style="max-width:160px" />
          <span asp-validation-for="CodePostal" style="color:var(--danger);font-size:0.78rem"></span>
        </div>
        <div style="display:flex;gap:12px;margin-top:8px">
          <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Créer</button>
          <a href="/Admin/Clients" class="btn btn-secondary">Annuler</a>
        </div>
      </form>
    </div>
  </div>
</div>
