@model DeliveryApp.Models.Vehicule
@{
    ViewData["Title"] = "Modifier le Véhicule";
    var isCamion = Model is DeliveryApp.Models.Camion;
    var camion = Model as DeliveryApp.Models.Camion;
    var voiture = Model as DeliveryApp.Models.Voiture;
    var livreurs = ViewBag.Livreurs as IEnumerable<DeliveryApp.Models.Livreur> ?? Enumerable.Empty<DeliveryApp.Models.Livreur>();
}

<div class="breadcrumb">
  <a href="/Admin/Vehicules">Véhicules</a><span>/</span> Modifier
</div>

<div style="max-width:600px">
  <h1 style="margin-bottom:22px">Modifier le Véhicule</h1>

  @if (TempData["Error"] != null)
  {
    <div style="background:rgba(239,68,68,0.1);color:var(--danger);padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:0.88rem;font-weight:500">
      <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
    </div>
  }

  <div class="card" style="margin-bottom:16px">
    <div class="card-body">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
        <div style="font-size:2.2rem">@(isCamion ? "🚛" : "🚗")</div>
        <span class="badge @(isCamion ? "badge-warning" : "badge-info")">
          @(isCamion ? "Camion" : "Voiture")
        </span>
      </div>

      <form asp-action="EditVehicule" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <!-- Entreprise propriétaire -->
        <div class="form-group">
          <label class="form-label">Entreprise (Livreur)</label>
          <select name="livreurId" class="form-control">
            <option value="">— Aucune entreprise —</option>
            @foreach (var l in livreurs)
            {
              <option value="@l.Id" selected="@(l.Id == Model.LivreurId)">@l.RaisonSociale — @l.Ville</option>
            }
          </select>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Marque <span style="color:var(--danger)">*</span></label>
            <input name="marque" class="form-control" value="@Model.Marque" required />
          </div>
          <div class="form-group">
            <label class="form-label">Couleur <span style="color:var(--danger)">*</span></label>
            <input name="couleur" class="form-control" value="@Model.Couleur" required />
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Matricule <span style="color:var(--danger)">*</span></label>
            <input name="matricule" class="form-control" value="@Model.Matricule" required />
            <span style="color:var(--text-muted);font-size:0.72rem">Doit être unique dans toute la base</span>
          </div>
          <div class="form-group">
            <label class="form-label">Vitesse Limite (km/h) <span style="color:var(--danger)">*</span></label>
            <input name="vitesseLimite" type="number" class="form-control" value="@Model.VitesseLimite" min="50" max="300" required />
          </div>
        </div>

        @if (isCamion && camion != null)
        {
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label">Capacité (kg) <span style="color:var(--danger)">*</span></label>
              <input name="capacite" type="number" class="form-control" value="@camion.Capacite" min="1" />
            </div>
            <div class="form-group">
              <label class="form-label">Nombre d'essieux <span style="color:var(--danger)">*</span></label>
              <input name="nbrEssieux" type="number" class="form-control" value="@camion.NbrEssieux" min="1" max="10" />
            </div>
          </div>
        }

        @if (!isCamion && voiture != null)
        {
          <div class="form-group">
            <label class="form-label">Nombre de places <span style="color:var(--danger)">*</span></label>
            <input name="nbrPlaces" type="number" class="form-control" value="@voiture.NbrPlaces" min="2" max="9" style="max-width:160px" />
          </div>
        }

        <div style="display:flex;gap:12px;margin-top:8px">
          <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Enregistrer</button>
          <a href="/Admin/Vehicules" class="btn btn-secondary">Annuler</a>
        </div>
      </form>
    </div>
  </div>
</div>
